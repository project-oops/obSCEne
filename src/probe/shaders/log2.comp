#version 450
/* log2: data[i] = log2(x)
 * base-2 logarithm (v_log); a non-positive input is a domain edge
 * One input, one output per lane; the section feeds a shared vector of edge-y values and
 * records the device's result bits for the recipient to diff against emulation. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    float x = data[i];
    data[i] = log2(x);
}
