#version 450
/* unpacksnorm: data[i] = unpackSnorm2x16(x).x
 * The low half of unpackSnorm2x16: the low 16 bits as a signed integer divided by 32767, then
 * clamped to [-1,1] (the value -32768/32767 is below -1 and clamps up). Exact - the device must
 * match the reference bit for bit. The input is a packed word from the bit-pattern vector; one
 * input, one output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = unpackSnorm2x16(bits).x;
}
