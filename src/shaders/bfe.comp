#version 450
/* bfe: data[i] = bitfieldExtract(floatBitsToUint(x), 8, 8)
 * Extracts the 8-bit field at offset 8 from the input's bit pattern. On RDNA this is v_bfe_u32
 * with immediate offset and width. The field is fixed so the op stays unary and the sweep's
 * bit-pattern input vector drives it; the extracted value (0..255) is written back as bits.
 * Exact - the device must match the reference bit for bit. One input, one output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = uintBitsToFloat(bitfieldExtract(bits, 8, 8));
}
