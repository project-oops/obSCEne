#version 450
/* findmsb: data[i] = intBitsToFloat(findMSB(floatBitsToUint(x)))
 * Position of the most-significant set bit (0..31), or -1 if the word is zero. On RDNA this is
 * v_ffbh_u32 - the unsigned form, chosen so the result is defined rather than sign-dependent.
 * The input lane is read as bits; the position is an int reinterpreted into the report's float
 * slot (so -1 appears as the all-ones word). Exact - the device must match bit for bit. One
 * input, one output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = intBitsToFloat(findMSB(bits));
}
