#version 450
/* bitreverse: data[i] = uintBitsToFloat(bitfieldReverse(floatBitsToUint(x)))
 * Reverses the order of the input's 32 bits. On RDNA this is v_bfrev_b32. The input lane is
 * read as bits and the reversed word is written back as bits - both reinterpretations, no float
 * value involved. Exact - the device must match the reference bit for bit. One input, one
 * output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = uintBitsToFloat(bitfieldReverse(bits));
}
