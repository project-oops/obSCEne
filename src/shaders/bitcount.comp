#version 450
/* bitcount: data[i] = intBitsToFloat(bitCount(floatBitsToUint(x)))
 * Population count of the input's 32 bits. On RDNA this is v_bcnt_u32_b32, an integer op
 * distinct from the float surface the intrinsic census maps - the start of the integer/bit
 * breadth. The input lane is read as bits, not a float value, so the shared float input vector
 * exercises a spread of bit patterns; the count (0..32) is an int reinterpreted into the
 * report's float slot. Exact - the device must match the reference bit for bit. One input,
 * one output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = intBitsToFloat(bitCount(bits));
}
