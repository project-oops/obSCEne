#version 450
/* findlsb: data[i] = intBitsToFloat(findLSB(floatBitsToUint(x)))
 * Position of the least-significant set bit (0..31), or -1 if the word is zero. On RDNA this is
 * v_ffbl_b32. The input lane is read as bits; the position is an int reinterpreted into the
 * report's float slot (so -1 appears as the all-ones word). Exact - the device must match bit
 * for bit. One input, one output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = intBitsToFloat(findLSB(bits));
}
