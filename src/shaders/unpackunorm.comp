#version 450
/* unpackunorm: data[i] = unpackUnorm2x16(x).x
 * The low half of unpackUnorm2x16: the low 16 bits of the word as an unsigned integer divided
 * by 65535. Exact - the device must match the reference bit for bit. The high half is symmetric,
 * so probing .x suffices. The input is a packed word, driven by the bit-pattern vector; one
 * input, one output per lane. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data.length()) {
        return;
    }
    uint bits = floatBitsToUint(data[i]);
    data[i] = unpackUnorm2x16(bits).x;
}
