+	// simply unreachable for these symbols.
+	//
+	// **This changes what is being measured.** It makes an unimplemented import behave the way
+	// shadPS4's generic stub does - accept the call, do nothing, return 0 - so a report from
+	// this build describes a patched Kyty, not Kyty, and has to say so. What it is good for is
+	// the *rest* of the surface: the imports Kyty really does implement can finally be
+	// exercised, and Kyty's own relocation log already names the ones it does not.
+	//
+	// B8 FF FF FF 7F          mov      eax, 0x7FFFFFFF
+	// C3                      ret
+	uint8_t code[16] = {0x31, 0xC0, 0xC3, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90};
