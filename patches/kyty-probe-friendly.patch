-		default: EXIT("invalid type: %d\n", type);
+		// LOCAL CHANGE (obSCEne): return EINVAL rather than terminating the process.
+		//
+		// POSIX specifies EINVAL for an unrecognised mutex type. Upstream calls EXIT(), so a
+		// caller that probes the type space - which is the only way to discover a mapping no
+		// header states - is killed by its first wrong guess rather than told no.
+		//
